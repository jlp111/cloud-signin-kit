# 复制为 .env 后按需填写（本文件本身不要提交）。
# 服务端会优先读这些变量，覆盖 config.json 里同名字段。

# ---------- 必填 ----------
# 后台管理密钥：访问 /panel /status /tick 等需要带 ?key= 或 Authorization: Bearer
ACCESS_KEY=REPLACE_WITH_RANDOM_32_CHARS

# ---------- 运行参数 ----------
PORT=8080
# 主循环间隔（分钟）。签到是一天一次的事，60 分钟足够；未签上时会在这个粒度上重试。
TICK_MINUTES=60
# WorkBuddy「猫猫旅行」的检查间隔（分钟）。它最费接口（一轮约 30~100 个请求）。
BUDDY_MINUTES=120
# 余额查询间隔（分钟）
BALANCE_MINUTES=360
# 保底自刷：refreshOwner=magpie 时，若 magpie 连续 N 天没同步且 access 快过期，云端破例自己刷一次
FALLBACK_AFTER_DAYS=7

# ---------- 可选：云端事件库（Postgres 兼容 BaaS）----------
# 留空则仅写本地 state.json
CLOUD_DB_ENDPOINT=
CLOUD_DB_KEY=
CLOUD_DB_RESOURCE=

# ---------- 可选：本机同步脚本用（scripts/*.mjs）----------
# 已部署服务的地址；不填则默认 http://127.0.0.1:$PORT
CLOUD_BASE=
# 托管平台要求分享码时填写（会附加到 ?sharecode=）
SHARE_CODE=
# 文件路径（默认都在项目根目录）
# CONFIG_PATH=
# STATE_PATH=
# LOG_FILE=          # 落盘日志，默认 ./run.log（同时打 stdout）
